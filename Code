#include <iostream>
#include <string>
using namespace std;

int main() {
    string str;

    cout << "Enter a string: ";
    getline(cin, str);

    for (int i = 0; i < str.length(); i++) {

        if (str[i] == 'z') {
            str[i] = 'a';
        }
        else if (str[i] == 'Z') {
            str[i] = 'A';
        }
        else if ((str[i] >= 'a' && str[i] < 'z') || (str[i] >= 'A' && str[i] < 'Z')) {
            str[i] = str[i] + 1;
        }
        // any other character (space, digit, symbol) is left as it is
    }

    cout << "Result: " << str << endl;

    return 0;
}
